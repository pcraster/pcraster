  def test_04(self):
    """test setting of row and column widths, pathlib"""
    # we just test the generated input file in subdirectory
    shutil.rmtree("rowcol", ignore_errors=True)
    os.mkdir("rowcol")

    subprocess.call([r"@Python_EXECUTABLE@", "bcf2ss_rowcol.py"])

    valid_dis = """# Generated by PCRaster Modflow
2 10 15 1 4 0
 1 0
INTERNAL   1.0 (FREE)    -1    DELR
2000 2001.01 2002.02 2003.03 2004.04 2005.05 2006.06 2007.07 2008.08 2009.09 2010.1 2011.11 2012.12 2013.13 2014.14 
INTERNAL   1.0 (FREE)    -1    DELC
5000 5001.01 5002.02 5003.03 5004.04 5005.05 5006.06 5007.07 5008.08 5009.09 
EXTERNAL 300 1.0 (FREE) -1  Top of system
EXTERNAL 300 1.0 (FREE) -1  Bottom layer 1
EXTERNAL 300 1.0 (FREE) -1  Bottom confinig bed layer 1
EXTERNAL 300 1.0 (FREE) -1  Bottom of system
1 1 1 SS
"""
    with open(pathlib.Path("rowcol", "pcrmf_dis.txt"), "r") as fp:
      dis = fp.read()
      
    self.assertEqual(dis, valid_dis)
      
suite = unittest.TestSuite()
suite.addTest(unittest.TestLoader().loadTestsFromTestCase(Test))

result = unittest.TextTestRunner(verbosity=3).run(suite)
